# SafeZone application
APP_ENV=development
APP_NAME=SafeZone API
LOG_LEVEL=INFO

# Backend server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_FRONTEND_ORIGINS=["http://localhost:5173"]

# PostgreSQL/PostGIS (replace with local development credentials)
DATABASE_URL=postgresql+asyncpg://safezone_user:change_me@localhost:5432/safezone
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
CRIME_CSV_MAX_BYTES=5242880

# JWT placeholders for the future authentication stage
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=safezone-api
JWT_AUDIENCE=safezone-clients

# Firebase placeholders for the future notification stage
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
NOTIFICATION_ADAPTER=auto
POLICE_LOCATION_MINIMUM_INTERVAL_SECONDS=15
POLICE_LOCATION_MAXIMUM_ACCURACY_METERS=250

# OSRM-compatible routing service placeholder
ROUTING_SERVICE_BASE_URL=http://localhost:5000
ROUTING_SERVICE_TIMEOUT_SECONDS=5
DEFAULT_PROXIMITY_RADIUS_METERS=3000
SOS_DISPATCH_RADIUS_METERS=10000
SOS_DISPATCH_CANDIDATE_LIMIT=5

# Explainable weighted risk model
RISK_FREQUENCY_WEIGHT=0.25
RISK_SEVERITY_WEIGHT=0.30
RISK_RECENCY_WEIGHT=0.30
RISK_TIME_WEIGHT=0.15
RISK_RECENCY_DECAY_LAMBDA=0.05
RISK_FREQUENCY_SATURATION_COUNT=5
RISK_TIME_RELEVANCE_FLOOR=0.25
RISK_SEVERITY_MAPPING={"1":0.2,"2":0.4,"3":0.6,"4":0.8,"5":1.0}
RISK_MODEL_VERSION=weighted-risk-v1
